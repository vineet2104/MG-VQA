# Copy to .env (gitignored). Never commit credentials.
# MG-VQA release planners and default scene perception use this gateway key:
NV_API_KEY=
# NVIDIA_API_KEY is an accepted alias; only one is needed.
# NVIDIA_API_BASE_URL=https://inference-api.nvidia.com/v1

# Optional Blender override; otherwise uses blender on PATH.
# BLENDER=/path/to/blender

# Optional native providers (see models.md):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional Hugging Face access/cache configuration:
# HF_TOKEN=
# HF_HOME=/path/to/cache
